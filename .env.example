# Local / Render environment for benjamin-be
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Required for attempt history + coach analytics
# Do not put sslmode=require in the URL (Node pg treats it as verify-full).
# Use DATABASE_SSL=true (default behavior) for managed Postgres like Aiven.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSL=true
# Set to false only for local Postgres without SSL
# DATABASE_SSL=false

# Shared passcode for /api/coach/* (and the FE /coach page)
COACH_PASSCODE=change-me
